          "workflow": {
            "id": "45e246b6-9a6f-5331-82cd-44c00f67cb18",
            "name": "QuotePilot RFQ Native v0.7",
            "description": "Synthetic RFQ -> SQL source -> platform LLM -> pending suggestion storage -> readback. No automatic business approval.",
            "source_type": "manual_dsl",
            "status": "disabled",
            "available_actions": [
              "update",
              "delete",
              "enable",
              "list_executions"
            ],
            "execution_mode": "one_shot",
            "execution_summary": {
              "total_executions": 0,
              "active_executions": 0
