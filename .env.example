# No secret values in this template. It is not loaded automatically.
QUOTEPILOT_PROVIDER=mock
GENESIS_BASE_URL=https://token.moi.matrixorigin.cn/v1
GENESIS_ACCESS_TOKEN=
GENESIS_MODEL_ID=qwen3.8-flash
GENESIS_API_STYLE=responses
# Same personal token was verified for Genesis Bearer and MOI X-API-Key.
# API scopes remain separate. An optional dedicated MOI_API_KEY takes precedence.
MOI_WORKSPACE_ID=
MOI_API_KEY=
# Use scripts/start_secure.py to enter the key invisibly without writing it to disk.

# Production mode requires HTTPS origin, login password, session secret.
# Prefer deploy/compose.yaml mounted secrets; never expose these to frontend.
QUOTEPILOT_ENV=development
QUOTEPILOT_PUBLIC_URL=
QUOTEPILOT_LOGIN_PASSWORD=
QUOTEPILOT_SESSION_SECRET=
QUOTEPILOT_NATIVE_RFQ=0
MOI_WORKFLOW_ID=


# Batch one: optional public search. Disabled until a free-only key and account limits are confirmed.
QUOTEPILOT_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
QUOTEPILOT_SEARCH_ENABLED=0
QUOTEPILOT_SEARCH_FREE_TIER_CONFIRMED=0
QUOTEPILOT_SEARCH_DAILY_LIMIT=20
# 可选独立业务复核账户；仅服务端配置，与管理员密码不同，至少12字符。留空则不启用。
QUOTEPILOT_REVIEWER_PASSWORD=
